---
import "@fontsource/host-grotesk";
import "@fontsource/space-grotesk";
import "@fontsource/major-mono-display";

import { Icon } from "astro-icon/components";
import { PROJECTS } from "../content/projects.ts";
import Skills from "../skills.astro";

const buildDate = new Date().toLocaleDateString();
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/theme.css"/>
    <link rel="stylesheet" href="/style.css"/>
    <link rel="stylesheet" href="/typography.css"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="generator" content={Astro.generator} />
    <title>Julian Leucker's Homepage</title>
</head>
<body>
<header>
    <Icon
        name="julian"
        height="100%"
    ></Icon>
    <!--<figure aria-label="Picture of me">-->
    <!--    <figcaption>-->
    <!--        Maybe a photo of me-->
    <!--    </figcaption>-->
    <!--</figure>-->
    <div>
        <h1>
            <span class="h2">Hi, I'm</span> <br />
            <span id="name">JULIAN LEUCKER</span>!</h1>
        <h2>Welcome to my homepage!</h2>
    </div>
</header>
<main>
    <section>
    <h2>Where to find me</h2>

    My work can be found on different git hosters, usually under the username <code>ZugBahnHof</code>¹.
    Find me on:

    <ul class="links">
        <li>
            <a href="https://github.com/ZugBahnHof/" style="--skill-color: #000000; --skill-text-color: #FFFFFF;">
                <Icon
                    name="fa6-brands:github"
                    height="100%"
                ></Icon>
                <h3>GitHub</h3>
            </a>
        </li>

        <!--
        <li>
            <a href="https://orcid.org/0009-0008-4558-4608" style="--skill-color: #A6CE39; --skill-text-color: #FFFFFF;">
                <Icon
                    name="fa7-brands:orcid"
                    height="100%"
                ></Icon>
                <h3>ORCID</h3>
            </a>
        </li>
        -->
        <!--
        <li>
            <a href="https://gitlab.com/ZugBahnHof/" style="--skill-color: #fc6d26; --skill-text-color: #FFFFFF;">
                <Icon
                    name="fa7-brands:gitlab"
                    height="100%"
                ></Icon>
                <h3>GitLab</h3>
            </a>
        </li>
        -->

        <li>
            <a href="https://edugit.org/ZugBahnHof/" style="--skill-color: #4c654c; --skill-text-color: #FFFFFF;">
                <Icon
                    name="fa7-brands:git"
                    height="100%"
                ></Icon>
                <h3>EduGit</h3>
            </a>
        </li>

        <!--
        <li>
            <a href="https://openhub.net/accounts/ZugBahnHof" style="--skill-color: #4a246b; --skill-text-color: #FFFFFF;">
                <span>OH</span>
                <h3>OpenHub</h3>
            </a>
        </li>
        -->

        <!--
        <li>
            <a href="https://codeberg.org/ZugBahnHof/" style="--skill-color: #2185d0; --skill-text-color: #FFFFFF;">
                <Icon
                    name="simple-icons:codeberg"
                    height="100%"
                ></Icon>
                <h3>Codeberg</h3>
            </a>
        </li>
        -->
    </ul>
    </section>

    <section>
    <h2>My Projects</h2>
    <ul class="projects">
        {PROJECTS.map((project) => (
            <li>
                <a href={project.url}>
                    {project.icon && (
                        <Icon
                            name={project.icon}
                            height="100%"
                            style="color: var(--text-700);"
                        ></Icon>
                    )}
                    {project.image && (
                        <img src={project.image} alt={project.imageAlt} />
                    )}
                    <h3>{project.name}</h3>
                    <p>{project.description}</p>
                </a>
            </li>
        ))}
    </ul>
    </section>

    <section>
    <h2>Skills</h2>
    <Skills />
    </section>
</main>

<div class="spacer"></div>

<footer>
    <p>© 2026 Julian Leucker</p>
    <p>All rights reserved.</p>
    <p>
        This site is built using <a href="https://astro.build">Astro</a> with handwritten HTML, CSS and JS.
        The source code was not generated by a large language model (LLM).
    </p>

    <details>
        <summary>1: Why »ZugBahnHof«?</summary>
        <p>
            The name doesn't carry any necessary meaning, it was just the first thing I could think of when creating
            my GitHub account, back in sixth grade.
        </p>
        <p>
            It can be translated as »TrainTrainStation«.
            While I do enjoy taking trains, I do not have a heightened interest in them, even if the name might
            suggest otherwise.
        </p>
    </details>
    <p>2: AlekSIS® is a registered trademark of the AlekSIS open source project, represented by Teckids e.V.</p>
    <p>Last built on: {buildDate}</p>
</footer>
</body>
</html>
